{
  "name": "urql-absinthe-upload-exchange",
  "version": "2.0.0",
  "description": "Urql exchange to support file uploads to an (Elixir) Absinthe backend",
  "scripts": {
    "build:mjs": "babel src --out-dir dist --extensions \".ts\" --out-file-extension .mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run build:mjs && npm run build:types",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9to5/urql-absinthe-upload-exchange.git"
  },
  "keywords": [
    "urql",
    "exchange",
    "upload",
    "elixir",
    "absinthe",
    "graphql"
  ],
  "author": "Tim de Booij",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/9to5/urql-absinthe-upload-exchange/issues"
  },
  "homepage": "https://github.com/9to5/urql-absinthe-upload-exchange#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.6",
    "@urql/core": "^6.0.3",
    "graphql": "^16.14.2",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "wonka": "^6.3.5"
  },
  "peerDependencies": {
    "@urql/core": ">=5.0.0",
    "graphql": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": false
    }
  },
  "packageManager": "pnpm@10.34.9"
}
